# ---------------------------------------------------------------------------
# Client-visible configuration only.
#
# Both values below are safe to ship in a browser bundle:
#   * The project URL is public.
#   * The anon/publishable key is designed for public clients; row level
#     security — not key secrecy — is what protects the data.
#
# NEVER put a service_role / secret key, database password or personal access
# token in a VITE_* variable: Vite inlines them into the JavaScript bundle.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Optional: the schema this app owns. Defaults to `tipping` in code.
# Keep `tipping` unless you deliberately fork the app for another schema.
# VITE_SUPABASE_SCHEMA=tipping
